# Copy to .env for local development (`npm run setup` does it and generates the secret).
# Never commit .env (NFR-SEC-02). Every variable is validated at startup by src/config/env.ts;
# the API refuses to boot on a missing or bad value and names the variable.

NODE_ENV=development
PORT=8000
LOG_LEVEL=debug

# Comma-separated browser origins allowed by CORS (web-ui dev server is :3000). The mobile app does not need CORS.
CORS_ORIGINS=http://localhost:8081,http://localhost:3000

# ── PostgreSQL 17 ────────────────────────────────────────────────────────────
# The same values you enter in pgAdmin → Register → Server → Connection.
# Local install: usually port 5432 (5433 if another PostgreSQL version already owns 5432).
# Docker option (`npm run services:up` starts it): DB_PORT=55432.
# Either create the database yourself (scripts/create_database.sql) or let the API do it:
# with DB_AUTO_CREATE=true it creates DB_NAME on boot if missing (the role needs CREATEDB).
# DB_AUTO_MIGRATE=true applies pending migrations on boot. Keep both false in production.
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=broadcastly
DB_PASSWORD=broadcastly
DB_NAME=broadcastly
DB_SSL=false
DB_AUTO_CREATE=true
DB_AUTO_MIGRATE=true 

# Started by `npm run services:up` (Docker, port 6380).
REDIS_URL=redis://localhost:6380

# ── Auth ─────────────────────────────────────────────────────────────────────
# At least 32 random characters. `npm run setup` generates one; or run:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=replace-with-at-least-32-random-characters
JWT_ACCESS_TTL=15m
# A session ends this many hours after sign-in, however often it is refreshed.
SESSION_TTL_HOURS=24
JWT_ISSUER=broadcastly-api
JWT_AUDIENCE=broadcastly-app

# Swagger UI at /api/docs. Keep false in production unless access is restricted.
API_DOCS_ENABLED=true

# Transactional SMS (sign-in codes). 'log' prints each message, code included, to the API console
# instead of sending it. Testing stand-in: the server starts with a warning until a provider is connected.
SMS_DRIVER=log

# Links to uploaded files (organisation logos) use this base URL; files live in UPLOADS_DIR.
PUBLIC_BASE_URL=http://localhost:8000
UPLOADS_DIR=uploads

# Credit purchases. 'simulate' settles purchases through the webhook without a real gateway
# (testing stand-in; the server starts with a warning). Price of one SMS credit in pesewas; set the
# agreed price per environment.
PAYMENT_DRIVER=simulate
CREDIT_PRICE_PESEWAS=4
