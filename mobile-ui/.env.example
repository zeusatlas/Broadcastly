# Copy to .env. Only EXPO_PUBLIC_* variables reach the app bundle.
# EXPO_PUBLIC_* values are readable by anyone who installs the app (NFR-SEC-02).
# Never put a credential, provider API key or payment secret here.

# In development, localhost is swapped for the computer Expo Go loaded the app from, so a phone
# on the same network reaches the API with no IP to type. Release builds require https://.
EXPO_PUBLIC_API_URL=http://localhost:8000/api/v1
